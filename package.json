{
  "name": "miniledger",
  "private": true,
  "version": "0.1.0",
  "description": "MiniLedger - track money you have lent to friends",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @miniledger/api",
    "db:seed": "npm run db:seed -w @miniledger/api",
    "dev:api": "npm run dev -w @miniledger/api",
    "test": "npm run test -w @miniledger/shared && npm run test -w @miniledger/api",
    "test:shared": "npm run test -w @miniledger/shared",
    "test:api": "npm run test -w @miniledger/api",
    "typecheck": "npm run typecheck -w @miniledger/shared && npm run typecheck -w @miniledger/api"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "@expo/config-plugins": "^58.0.9"
  }
}
