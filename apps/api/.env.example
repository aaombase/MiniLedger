# Copy to apps/api/.env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Matches the role/database created by docker-compose.yml (or by the setup commands in the README).
DATABASE_URL=postgres://miniledger:miniledger_dev@localhost:5432/miniledger
# Used by the API test suite only; the suite wipes this database between tests.
TEST_DATABASE_URL=postgres://miniledger:miniledger_dev@localhost:5432/miniledger_test

# At least 32 characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=change-me-to-a-long-random-string-0123456789abcdef

# Assignment-only: the OTP is printed in this server's log instead of being sent by SMS.
OTP_DELIVERY=console

SESSION_TTL_DAYS=30
UPLOAD_DIR=./uploads
IP_RATE_LIMIT_PER_MINUTE=120
