# Copy to apps/mobile/.env
#
# The URL of the MiniLedger API as seen FROM YOUR PHONE. "localhost" will NOT work: on a phone it means the phone.
# Use your computer's LAN IPv4 address (Windows: run `ipconfig`, look for "IPv4 Address" on your Wi-Fi adapter),
# and make sure the phone is on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
